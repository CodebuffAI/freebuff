{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "base2",
  "model": "openrouter/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
  "provider": {
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "sk-or-PASTE_YOUR_OPENROUTER_KEY_HERE"
      },
      "models": {
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free": { "name": "Nemotron 3 Nano Omni 30B (free)" },
        "google/gemma-4-26b-a4b-it:free": { "name": "Gemma 4 26B (free)" }
      }
    }
  }
}