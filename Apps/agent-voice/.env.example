# Paddle checkout overlay. Copy to `.env` and fill in — `.env` is gitignored.
#
# Client-side token from Paddle → Developer tools → Authentication. It is safe
# to ship in the bundle; it only authorises opening checkout.
VITE_PADDLE_TOKEN=

# Price id of the one-time Pro price (Paddle → Catalog → product → Prices).
VITE_PADDLE_PRICE_ID=

# `sandbox` (default) or `production`.
VITE_PADDLE_ENV=sandbox

# Build-time Rust knobs. These are *not* read from .env — pass them to cargo:
#
#   AGENT_VOICE_WORKER_URL=https://licenses.example.com \
#   AGENT_VOICE_ENTITLEMENT_PUBKEY="$(base64 -w0 entitlement.pub)" \
#     cargo tauri build
#
# See docs/entitlement.md before rotating either one.