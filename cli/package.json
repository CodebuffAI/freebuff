{
  "name": "@codebuff/cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "codebuff-tui": "./bin/codecane"
  },
  "exports": {
    ".": {
      "bun": "./src/entry.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "bun run prebuild:agents && bun run src/entry.ts --cwd ..",
    "prebuild:agents": "bun run scripts/prebuild-agents.ts",
    "build:binary": "bun ./scripts/build-binary.ts codebuff $npm_package_version",
    "release": "bun run scripts/release.ts",
    "test": "NODE_ENV=production bun test $(bun run --silent test:files)",
    "test:files": "find src \\( -name '*.test.ts' -o -name '*.test.tsx' \\) ! -name '*.integration.test.ts' ! -name '*.integration.test.tsx' 2>/dev/null | sort",
    "test:files:integration": "find src \\( -name '*.integration.test.ts' -o -name '*.integration.test.tsx' \\) 2>/dev/null | sort",
    "test:tmux-poc": "bun run src/__tests__/tmux-poc.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "sideEffects": [
    "./src/pre-init/*.ts"
  ],
  "engines": {
    "bun": "1.3.11"
  },
  "dependencies": {
    "@codebuff/sdk": "workspace:*",
    "@gravity-ai/api": "^0.1.2",
    "@opentui/core": "0.3.4",
    "@opentui/react": "0.3.4",
    "@tanstack/react-query": "^5.90.12",
    "commander": "^14.0.1",
    "immer": "^10.1.3",
    "jimp": "^1.6.0",
    "node-machine-id": "^1.1.12",
    "open": "^10.1.0",
    "pino": "9.4.0",
    "posthog-node": "^5.8.0",
    "react": "^19.0.0",
    "react-reconciler": "^0.32.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "string-width": "^7.2.0",
    "systeminformation": "^5.30.7",
    "terminal-image": "^4.1.0",
    "ts-pattern": "^5.9.0",
    "unified": "^11.0.0",
    "wsl-utils": "^0.1.0",
    "yoga-layout": "^3.2.1",
    "zod": "^4.2.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-reconciler": "^0.32.0",
    "@types/tar": "^6.1.13",
    "react-dom": "^19.0.0",
    "strip-ansi": "^7.1.2",
    "tar": "^7.0.0"
  }
}
