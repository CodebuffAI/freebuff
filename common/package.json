{
  "name": "@codebuff/common",
  "version": "1.0.0",
  "description": "Common utilities for Codebuff",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "bun": "./src/*.ts",
      "import": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test $(bun run --silent test:files)",
    "test:files": "find src -name '*.test.ts' ! -name '*.integration.test.ts' 2>/dev/null | sort",
    "test:files:integration": "find src -name '*.integration.test.ts' 2>/dev/null | sort"
  },
  "sideEffects": false,
  "engines": {
    "bun": "1.3.14"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@types/seedrandom": "^3.0.8",
    "ai": "^7.0.59",
    "gray-matter": "^4.0.3",
    "ignore": "5.3.2",
    "lodash": "4.17.23",
    "posthog-node": "^5.8.0",
    "seedrandom": "^3.0.5",
    "stripe": "^16.11.0",
    "zod": "^4.2.1",
    "zod-from-json-schema": "0.4.2"
  }
}
